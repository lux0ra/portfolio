{
    "name": "lux0ra-portfolio",
    "private": true,
    "version": "26.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "wrangler types && vite build",
        "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
        "prepare": "svelte-kit sync || echo ''",
        "check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "gen": "wrangler types"
    },
    "devDependencies": {
        "@sveltejs/adapter-cloudflare": "^8.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.3.0",
        "svelte": "^5.57.1",
        "svelte-check": "^4.6.0",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.0",
        "wrangler": "^4.97.0"
    },
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    },
    "dependencies": {
        "@fontsource-variable/geist": "^5.3.0"
    }
}
