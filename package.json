{
    "name": "lux0ra-portfolio",
    "private": true,
    "version": "26.1.0",
    "type": "module",
    "scripts": {
        "dev": "wrangler types && vite dev",
        "build": "wrangler types && vite build",
        "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
        "prepare": "svelte-kit sync || echo ''",
        "check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "gen": "wrangler types",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@sveltejs/adapter-cloudflare": "^8.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@tailwindcss/vite": "^4.3.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.24.0",
        "globals": "^17.14.0",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "svelte": "^5.57.1",
        "svelte-check": "^4.6.0",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.0",
        "wrangler": "^4.97.0"
    },
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    },
    "dependencies": {
        "@fontsource-variable/geist": "^5.3.0"
    }
}
